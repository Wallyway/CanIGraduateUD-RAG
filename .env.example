# ==============================================================================
# CanIGraduateUD-RAG - Configuración de Entorno
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEEDOR LLM (Activo: OpenRouter)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Resiliencia y Fallback Nativo OpenRouter (>200 usuarios concurrentes)
# Modelos de contingencia ordenados por prioridad en caso de tasa límite o indisponibilidad
OPENROUTER_FALLBACK_MODELS="meta-llama/llama-3.3-70b-instruct,google/gemini-2.0-flash-001"
OPENROUTER_TIMEOUT=30.0
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BACKOFF_FACTOR=1.5

# [OPCIONAL / ALTERNATIVO] Embeddings remotos (por defecto usa fallback local)
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=text-embedding-3-small

# [OPCIONAL / ALTERNATIVO] Si prefieres OpenAI directo en lugar de OpenRouter:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# [OPCIONAL / ALTERNATIVO] Si prefieres Google Gemini directo en lugar de OpenRouter:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. CREDENCIALES DE ADMINISTRADOR (Panel de Control UD)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin_ud
ADMIN_PASSWORD=graduacion_sistemas_2026!
JWT_SECRET_KEY=can-i-graduate-ud-secret-key-change-in-production-random-hash-9823479234
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 3. SINCRONIZACIÓN DE CORREO POR IMAP (Activo: canigraduateud@gmail.com)
# ------------------------------------------------------------------------------
IMAP_ENABLED=true
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=canigraduateud@gmail.com
IMAP_PASSWORD=your-gmail-app-password-here
IMAP_POLL_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# 4. WEBHOOK ENTRANTE (Opcional si se usa Power Automate HTTP o Make.com)
# ------------------------------------------------------------------------------
# Solo se usa si envías correos mediante llamadas HTTP externas:
# WEBHOOK_SECRET_KEY=ud-incoming-email-webhook-secret-token-12345

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 5. RUTAS Y BASE DE DATOS (PostgreSQL en Producción / SQLite en Local)
# ------------------------------------------------------------------------------
DATA_DIR=data
CHROMA_PERSIST_DIRECTORY=data/chroma

# Opción A (Producción Oracle Cloud / Docker Compose con PostgreSQL):
POSTGRES_DB=can_i_graduate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=graduacion_sistemas_postgres_2026!
DATABASE_URL=postgresql+psycopg2://postgres:graduacion_sistemas_postgres_2026!@postgres:5432/can_i_graduate
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Opción B (Desarrollo local rápido sin Docker con SQLite):
# DATABASE_URL=sqlite:///data/database.sqlite

# ------------------------------------------------------------------------------
# 6. CONCURRENCIA DE STREAMING Y KEEP-ALIVE (>200 usuarios concurrentes)
# ------------------------------------------------------------------------------
# Límite máximo de conexiones SSE activas simultáneas antes de responder 503 Retry-After
STREAM_CONCURRENCY_LIMIT=150
# Intervalo en segundos para emitir tramas de latido SSE (: ping) y evitar cortes de proxy
SSE_KEEPALIVE_INTERVAL_SECONDS=15
# Configuración de cola de espera virtual ante picos de concurrencia (>150 conexiones)
QUEUE_MAX_WAIT_SECONDS=15.0
QUEUE_CAPACITY=100

# ------------------------------------------------------------------------------
# 7. CONFIGURACIÓN DE RED Y URLs
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE TUNNEL (Opcional para túnel de producción sin abrir puertos)
# ------------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
